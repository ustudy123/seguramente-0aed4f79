# Ambiente de Staging/Testes — YourEyes
# Preencha com os valores do projeto Supabase de staging criado manualmente.
# Não armazene dados reais de clientes neste ambiente.

SUPABASE_URL="https://<staging-project-id>.supabase.co"
VITE_SUPABASE_URL="https://<staging-project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<staging-anon-key>"
VITE_SUPABASE_PUBLISHABLE_KEY="<staging-anon-key>"
VITE_SUPABASE_PROJECT_ID="<staging-project-id>"
# URL onde o BUILD DE STAGING ficará acessível (host próprio de teste).
# NUNCA aponte para a URL de produção: os links de convite, redefinição de
# senha e e-mails gerados no staging levariam o usuário para o app real.
VITE_APP_URL="https://<staging-app-url>"
